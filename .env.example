# --- Database ---
# Any PostgreSQL instance works. For local development, run one yourself
# (e.g. `postgresql://postgres:postgres@localhost:5432/cascade`) and set
# both variables below to that same URL. For deployment (Vercel,
# Cloudflare, etc.), use a managed provider such as Neon or Supabase.
#
# DATABASE_URL: the connection the app uses at runtime. On Supabase, use
# the pooled "Transaction" connection string (port 6543, includes
# "?pgbouncer=true") -- serverless functions open many short-lived
# connections and the pooler is required to not exhaust Postgres' direct
# connection limit. On Neon or a plain Postgres instance, just use the
# normal connection string here.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
#
# DIRECT_URL: an unpooled connection, used only for `prisma db push` /
# migrations (the pooler doesn't support the commands migrations need).
# On Supabase, this is the "Session" connection string (port 5432, no
# pgbouncer param). On Neon or plain Postgres, set this to the exact same
# value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Auth (Auth.js / NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Public base URL of the deployment, used for callback URLs.
NEXTAUTH_URL="http://localhost:3000"

# --- App ---
# Default currency code used across financial displays (see src/lib/currency.ts)
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"

# --- Future integrations (not required for the MVP) ---
# SMS_PROVIDER_API_KEY=
# EMAIL_PROVIDER_API_KEY=
# PAYMENT_GATEWAY_SECRET_KEY=
