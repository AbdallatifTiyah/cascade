# --- Database ---
# Local demo default: file-based SQLite, zero configuration required.
# For production, point this at a managed PostgreSQL instance instead
# (e.g. Supabase/Neon/RDS) and run `npm run db:migrate` -- the schema
# uses no SQLite-only features so the switch is a one-line change to
# prisma/schema.prisma ("provider = \"postgresql\"").
DATABASE_URL="file:./dev.db"

# --- Auth (Auth.js / NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Public base URL of the deployment, used for callback URLs.
NEXTAUTH_URL="http://localhost:3000"

# --- App ---
# Default currency code used across financial displays (see src/lib/currency.ts)
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"

# --- Future integrations (not required for the MVP) ---
# SMS_PROVIDER_API_KEY=
# EMAIL_PROVIDER_API_KEY=
# PAYMENT_GATEWAY_SECRET_KEY=
