# --- Database ---
# Any PostgreSQL instance works. For local development, run one yourself
# (e.g. `postgresql://postgres:postgres@localhost:5432/cascade`). For
# deployment (Vercel, Cloudflare, etc.), use a managed provider such as
# Neon or Supabase -- both have a generous free tier and give you a
# connection string in this same format.
DATABASE_URL="postgresql://user:password@host:5432/cascade"

# --- Auth (Auth.js / NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Public base URL of the deployment, used for callback URLs.
NEXTAUTH_URL="http://localhost:3000"

# --- App ---
# Default currency code used across financial displays (see src/lib/currency.ts)
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"

# --- Future integrations (not required for the MVP) ---
# SMS_PROVIDER_API_KEY=
# EMAIL_PROVIDER_API_KEY=
# PAYMENT_GATEWAY_SECRET_KEY=
